# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/studyos
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional: Google and Microsoft sign-in (buttons appear only when both values are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional in development (emails are printed to the server log), required in production
RESEND_API_KEY=
EMAIL_FROM="StudyOS <no-reply@example.com>"

LOG_LEVEL=info
