# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/studyos
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional: Google and Microsoft sign-in (buttons appear only when both values are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional in development (emails are printed to the server log), required in production
RESEND_API_KEY=
EMAIL_FROM="StudyOS <no-reply@example.com>"

LOG_LEVEL=info

# Documents. Development defaults to files on disk in .data/storage.
# Production requires STORAGE_DRIVER=s3 (Cloudflare R2 or any S3-compatible store).
STORAGE_DRIVER=local
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=studyos
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# UPLOAD_MAX_MB=50
# STORAGE_QUOTA_MB=2048
# OCR_ENABLED=true
# LIBREOFFICE_PATH=/usr/bin/soffice
# WORKER_CONCURRENCY=2
