    "@hookform/resolvers": "^5.9.1",
    "@napi-rs/canvas": "^1.0.10",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-highlight": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-mathematics": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/suggestion": "3.31.4",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.3",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "geist": "^1.7.2",
    "katex": "^0.16.47",
    "lucide-react": "^1.52.0",
    "mammoth": "^1.13.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "pg-boss": "^12.36.0",
    "pino": "^10.4.0",
