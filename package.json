    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "sql.js": "^1.14.2",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "ts-fsrs": "5.4.2",
    "tsx": "^4.23.15",
    "unpdf": "^1.8.1",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.5"
